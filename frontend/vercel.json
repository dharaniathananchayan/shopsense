{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://shopsense-xkn1.onrender.com/api/:match*"
    },
    {
      "source": "/static/:match*",
      "destination": "https://shopsense-xkn1.onrender.com/static/:match*"
    },
    {
      "source": "/((?!api/|static/).*)",
      "destination": "/index.html"
    }
  ]
}
